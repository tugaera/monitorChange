{
  "name": "monitorchange",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:capture": "tsx watch apps/capture/src/server.ts",
    "dev:egress": "tsx watch apps/egress/src/server.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "start": "node dist/apps/api/src/server.js",
    "start:capture": "node dist/apps/capture/src/server.js",
    "start:egress": "node dist/apps/egress/src/server.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "8.3.0",
    "better-sqlite3": "12.11.1",
    "cheerio": "1.2.0",
    "fastify": "5.12.8",
    "ipaddr.js": "2.5.0",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tldts": "7.5.2",
    "undici": "7.30.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
