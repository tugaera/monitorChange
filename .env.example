# Copy to .env and use the IPv4 address of the server's LAN interface.
LAN_BIND_IP=192.0.2.10
PUBLIC_ORIGIN=http://192.0.2.10:3100
# Generate two different random values, at least 32 characters each.
BOOTSTRAP_TOKEN=replace-with-a-unique-random-bootstrap-token
INTERNAL_TOKEN=replace-with-a-different-random-internal-token

# Optional: use images published by .github/workflows/publish.yml instead of local builds.
# IMAGE_PREFIX=ghcr.io/owner/repository
# IMAGE_TAG=latest
